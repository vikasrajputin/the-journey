{
  "name": "the-journey",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "check": "npm run lint && npm run typecheck && npm test",
    "build:pages": "STATIC_EXPORT=1 NEXT_PUBLIC_BASE_PATH=/the-journey NEXT_PUBLIC_SITE_URL=https://vikasrajputin.github.io/the-journey next build && touch out/.nojekyll"
  },
  "dependencies": {
    "d3-geo": "^3.1.2",
    "lenis": "^1.3.27",
    "next": "15.5.29",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "three": "^0.170.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.170.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "playwright-core": "1.63.0"
  }
}
